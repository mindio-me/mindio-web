FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
ARG SERVER_VERSION=latest
RUN apk add --no-cache wget && \
    if [ "$SERVER_VERSION" = "latest" ]; then \
      wget -O mindio-server.jar "https://github.com/mindio-me/mindio-web/releases/latest/download/mindio-server.jar"; \
    else \
      wget -O mindio-server.jar "https://github.com/mindio-me/mindio-web/releases/download/v${SERVER_VERSION}/mindio-server.jar"; \
    fi
EXPOSE 8080
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"
CMD ["sh", "-c", "java $JAVA_OPTS -jar mindio-server.jar --spring.profiles.active=prod"]
