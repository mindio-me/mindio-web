# Java后端内部API地址与共享密钥（对应 spring-boot 的 agent.internal-token 配置）
JAVA_INTERNAL_BASE_URL=http://localhost:8080/api
INTERNAL_SHARED_TOKEN=dev-only-internal-token-change-in-production

# 默认使用的模型provider：anthropic | openai | deepseek | doubao
DEFAULT_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-2-0-pro-260215
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com
DOUBAO_CHAT_PATH=/api/v3/chat/completions

# 火山引擎/豆包语音识别（大模型录音文件极速版，transcribe_audio 工具用）
# 两种鉴权模式二选一，别混填，混填会导致服务端按错的模式去查授权(grant)，报
# "load grant: requested grant not found"，跟key本身对不对无关：
# 新版"豆包语音"控制台：只填 VOLCENGINE_ASR_APP_KEY = 控制台"API Key管理"里的那个Key，
#   VOLCENGINE_ASR_ACCESS_KEY 留空——代码只会发 X-Api-Key 这一个头
# 旧版控制台：VOLCENGINE_ASR_APP_KEY=App ID，VOLCENGINE_ASR_ACCESS_KEY=Access Token，两个都填
VOLCENGINE_ASR_APP_KEY=
VOLCENGINE_ASR_ACCESS_KEY=
