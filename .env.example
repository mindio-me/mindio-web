# Database
DB_USERNAME=mindio
DB_PASSWORD=change_this_password
DB_ROOT_PASSWORD=change_this_root_password

# JWT (use a long random string, min 32 characters)
JWT_SECRET=change_this_to_a_long_random_secret_string

# Your site URL (no trailing slash)
SITE_URL=http://localhost

# Port (default: 80)
PORT=80

# Shared secret between server and agent for internal API auth (long random string)
AGENT_INTERNAL_TOKEN=change_this_to_a_long_random_secret_string

# AI provider for the agent service — anthropic | openai | deepseek | doubao
AGENT_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=

# Volcengine/Doubao ASR (optional, only needed for voice recording transcription)
VOLCENGINE_ASR_APP_KEY=
VOLCENGINE_ASR_ACCESS_KEY=
